# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metric-tracker

# NextAuth: generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
# Public URL of the app (https://your-domain in production)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SEO Analytics (/dashboard/seo) — Google service account, server-side only.
# See "SEO Analytics" in README.md for setup. Paste the key on one line with \n for line breaks.
GOOGLE_ANALYTICS_CLIENT_EMAIL=seo-dashboard@your-project.iam.gserviceaccount.com
GOOGLE_ANALYTICS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Search Console property, exactly as it appears in Search Console: sc-domain:example.com or https://www.example.com/
GSC_SITE_URL=sc-domain:example.com
# GA4 property ID (Admin → Property details), numbers only
GA4_PROPERTY_ID=123456789
# Development only: show labelled synthetic data instead of calling Google. Ignored in production.
SEO_ANALYTICS_DEMO=false
