# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metric-tracker

# NextAuth: generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
# Public URL of the app (https://your-domain in production)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI summaries: any OpenAI-compatible provider, called through the OpenAI SDK
# Endpoint, e.g. https://api.groq.com/openai/v1 (leave empty for OpenAI)
AI_BASE_URL=
# API key for that provider
AI_PROVIDER_API_KEY=
# Model id on that provider; it must support JSON mode, e.g. openai/gpt-oss-120b on Groq
AI_MODEL=

# Single Zedu project owner/delegated Review Coordinator user IDs (comma-separated).
# Unset: human revision requests are forbidden; eligible peer agents can still review.
REVIEW_COORDINATOR_USER_IDS=
