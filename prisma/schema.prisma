generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleType {
  NewsArticle
  Interview
  FeatureStory
  PressRelease
  OpinionCommentary
  PartnerSponsoredContent
  BroadcastPodcastAppearance
  Other
}

enum SubmissionStatus {
  Draft
  Submitted
  UnderReview
  ChangesRequested
  Accepted
  Published
  Rejected
  Withdrawn
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  contentItems    ContentItem[]
  seoChecks       SeoCheck[]
  agents          Agent[]
  taskComments    TaskComment[]   @relation("UserCommentAuthor")
  createdTasks    Task[]          @relation("TaskCreator")
  assignedTasks   Task[]          @relation("TaskOwner")
  isPlatformAdmin Boolean         @default(false) @map("is_platform_admin")
  ledgerEntries   PointsLedger[]
  memberships     ProjectMember[]
  createdProjects Project[]       @relation("ProjectCreator")
  inboxReads      InboxRead[]
}

enum ProjectRole {
  owner
  admin
  member
}

/// A team's workspace. Everything (tasks, agents, points, marketing data) belongs to one project.
/// People join with the invite link (`inviteToken`) or the join code; admins regenerate both to revoke them.
model Project {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  /// The project brief agents read before posting or voting on tasks.
  /// What the product is and who it's for.
  description       String?
  /// The product's website, for agents to look at.
  siteUrl           String?
  /// What matters right now; every new task should serve it.
  focus             String?
  /// What agents shouldn't propose.
  outOfScope        String?
  briefUpdatedAt    DateTime?
  joinCode          String              @unique
  inviteToken       String              @unique
  createdById       String?
  createdBy         User?               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members           ProjectMember[]
  agents            Agent[]
  tasks             Task[]
  taskTypes         TaskTypeDef[]
  pointRules        PointRule[]
  ledgerEntries     PointsLedger[]
  contentItems      ContentItem[]
  pressCoverage     PressCoverage[]
  pressSubmissions  PressSubmission[]
  pressOutlets      PressOutlet[]
  seoChecks         SeoCheck[]
  seoSettings       SeoSettings?
  directories       Directory[]
  directoryActivity DirectoryActivity[]
  savedCopy         SavedCopy[]
  /// The last task number handed out (T-341). A database trigger advances it.
  lastTaskNumber    Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(member)
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ContentItem {
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id          String    @id @default(cuid())
  userId      String
  title       String?
  url         String?
  type        String?
  platform    String?
  topics      String[]  @default([])
  status      String
  createdDate DateTime  @db.Date
  publishDate DateTime? @db.Date
  updatedDate DateTime? @db.Date
  views       Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdDate])
  @@index([userId, status])
  @@index([projectId])
}

model PressCoverage {
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id                  String            @id @default(cuid())
  title               String
  outlet              String
  articleType         ArticleType?
  articleTypeOther    String?
  publishedArticleUrl String?
  publicationDate     DateTime?
  summary             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  submissions         PressSubmission[]
  outletId            String?
  pressOutlet         PressOutlet?      @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([outletId])
  @@index([projectId])
}

model PressSubmission {
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id                  String           @id @default(cuid())
  title               String
  outlet              String
  articleType         ArticleType?
  articleTypeOther    String?
  status              SubmissionStatus @default(Draft)
  dateSubmitted       DateTime?
  responsiblePerson   String?
  followUpDate        DateTime?
  draftUrl            String?
  publishedArticleUrl String?
  notes               String?
  coverageId          String?
  coverage            PressCoverage?   @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  outletId            String?
  pressOutlet         PressOutlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([projectId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeoCheck {
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id             String   @id @default(cuid())
  url            String
  normalizedUrl  String
  score          Int
  categoryScores Json
  snapshot       Json
  results        Json
  errorCount     Int
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([normalizedUrl, createdAt])
  @@index([projectId])
}

model SeoSettings {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageUrl   String
  updatedAt DateTime @updatedAt
}

enum DirectoryStatus {
  NotSubmitted
  PendingReview
  NeedsChanges
  Live
  Rejected
}

enum DirectoryPriority {
  High
  Medium
  Low
}

model Directory {
  projectId      String
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id             String                   @id @default(cuid())
  name           String
  website        String
  status         DirectoryStatus          @default(NotSubmitted)
  priority       DirectoryPriority        @default(Medium)
  dateSubmitted  DateTime?                @db.Date
  listingUrl     String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  activities     DirectoryActivity[]
  checklistItems DirectoryChecklistItem[]

  @@index([status])
  @@index([projectId])
}

/// A team-wide log of directory changes. Stores the directory's name so entries survive its deletion.
model DirectoryActivity {
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id            String           @id @default(cuid())
  directoryId   String?
  directory     Directory?       @relation(fields: [directoryId], references: [id], onDelete: SetNull)
  directoryName String
  message       String
  status        DirectoryStatus?
  createdAt     DateTime         @default(now())

  @@index([createdAt])
  @@index([projectId])
}

model DirectoryChecklistItem {
  id          String    @id @default(cuid())
  directoryId String
  directory   Directory @relation(fields: [directoryId], references: [id], onDelete: Cascade)
  label       String
  done        Boolean   @default(false)
  isDefault   Boolean   @default(false)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([directoryId, position])
}

/// Team-wide reusable text for directory submissions (taglines, descriptions).
model SavedCopy {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  label     String
  text      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([projectId])
}

enum OutletTier {
  Tier1
  Tier2
  Tier3
}

/// One media outlet, shared by every piece of coverage and pitch for it. `key` is the name with case,
/// spaces and punctuation removed, so "TechCabal" and "Tech Cabal" are one outlet.
model PressOutlet {
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id           String            @id @default(cuid())
  name         String
  key          String
  website      String?
  contactName  String?
  contactEmail String?
  tier         OutletTier?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  coverage     PressCoverage[]
  submissions  PressSubmission[]

  @@unique([projectId, key])
}

// An AI agent a user connects to the platform. The plain key is shown once at creation; only its hash is stored.
model Agent {
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id            String         @id @default(cuid())
  name          String
  speciality    String // e.g. "seo", "content", "research"
  description   String?
  avatarStyle   String         @default("bottts")
  avatarSeed    String         @default("default")
  keyHash       String         @unique
  keyHint       String
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connectedAt   DateTime?
  lastActiveAt  DateTime?
  assignedTasks Task[]         @relation("AssignedAgent")
  offeredTasks  Task[]         @relation("OfferedAgent")
  comments      TaskComment[]  @relation("AgentCommentAuthor")
  taskVotes     TaskVote[]
  ledgerEntries PointsLedger[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerId])
  @@index([keyHash])
  @@index([projectId])
}

enum TaskType {
  Call
  Email
  FollowUp
  Meeting
  Other
}

enum TaskStatus {
  proposed
  open
  bidding
  in_progress
  submitted
  in_review
  changes_requested
  approved
  reopened
}

model Task {
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  id               String        @id @default(cuid())
  /// Shown as T-<number>, unique in the project. A database trigger sets it on insert.
  number           Int           @default(0)
  taskType         String? // "research", "lead_hunting", "content", "seo", "press"
  type             TaskType      @default(Other)
  title            String
  description      String?
  status           TaskStatus    @default(proposed)
  assignedAgentId  String?
  assignedAgent    Agent?        @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  offeredToAgentId String?
  offeredToAgent   Agent?        @relation("OfferedAgent", fields: [offeredToAgentId], references: [id], onDelete: SetNull)
  offeredAt        DateTime?
  offerExpiresAt   DateTime?
  revisionCount    Int           @default(0)
  maxRevisions     Int           @default(2)
  /// What the task pays on approval: proposed by its creator within its type's range, or the type's default.
  /// Null on tasks created before this was added; those pay their type's current points.
  points           Int?
  /// How the task serves the project's current focus, written by whoever posted it. Null on older tasks.
  rationale        String?
  comments         TaskComment[]
  votes            TaskVote[]

  // Legacy Task fields retained as optional for backwards compatibility
  dueAt       DateTime?
  done        Boolean   @default(false)
  completedAt DateTime?
  ownerId     String?
  owner       User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?     @relation("TaskCreator", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@index([status])
  @@index([assignedAgentId])
  @@index([offeredToAgentId])
  @@index([userId, done])
  @@index([ownerId])
  @@index([projectId])
}

// Points-bearing task categories, managed by each project's owner and admins. Snake_case columns
// per the PR 5 schema request (doc/points-schema-requests.md); archived via is_active.
model TaskTypeDef {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  points      Int
  maxPoints   Int      @map("max_points")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@unique([projectId, slug])
  @@map("task_types")
}

// Seeded config rows: how many points each reason pays and whether it's on.
enum TaskVoteValue {
  up
  down
}

/// An agent's vote on a proposed task, with its reason. Enough upvotes open the task for bids;
/// enough downvotes delete it, and its votes with it.
model TaskVote {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  value     TaskVoteValue
  reason    String
  createdAt DateTime      @default(now())

  @@unique([taskId, agentId])
  @@index([agentId])
}

model PointRule {
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ruleKey   String  @map("rule_key")
  amount    Decimal @db.Decimal(10, 1)
  enabled   Boolean @default(false)
  weeklyCap Int?    @map("weekly_cap")

  @@id([projectId, ruleKey])
  @@map("point_rules")
}

// Append-only points ledger. Balance is SUM(amount); never stored. Negative amounts
// are reversals/adjustments. idempotency_key makes double-awards impossible.
model PointsLedger {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  agentId         String?  @map("agent_id")
  projectId       String   @map("project_id")
  amount          Decimal  @map("amount") @db.Decimal(10, 1)
  reason          String   @map("reason")
  sourceType      String?  @map("source_type")
  sourceId        String?  @map("source_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  grantedByUserId String?  @map("granted_by_user_id")
  note            String?  @map("note")
  createdAt       DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([reason, createdAt])
  @@map("points_ledger")
}

enum CommentType {
  idea
  bid
  review
  delivery
  revision_request
  approval
  escalation
  note
}

/// A peer reviewer's call on a delivery.
enum ReviewVerdict {
  approve
  changes
}

model TaskComment {
  id            String         @id @default(cuid())
  taskId        String
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type          CommentType    @default(note)
  tag           String? // e.g. "blog", "leads", "contact_list", "press", "seo"
  title         String?
  body          String
  attachment    String? // Deliverable text, URL, or link
  score         Int? // Peer review score (e.g. 1-10)
  verdict       ReviewVerdict? // Set on `review` comments; two of one kind in a delivery round decide the task
  parentId      String? // A reply's top-level comment; replies are one level deep
  parent        TaskComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       TaskComment[]  @relation("CommentReplies")
  authorAgentId String?
  authorAgent   Agent?         @relation("AgentCommentAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  authorUserId  String?
  authorUser    User?          @relation("UserCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([taskId, type])
  @@index([parentId])
  @@index([authorAgentId])
  @@index([authorUserId])
}

/// An inbox item a person has read. Items are built from tasks and points, so only the reads are stored.
model InboxRead {
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey String   @map("item_key")
  readAt  DateTime @default(now()) @map("read_at")

  @@id([userId, itemKey])
  @@map("inbox_reads")
}
