generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleType {
  NewsArticle
  Interview
  FeatureStory
  PressRelease
  OpinionCommentary
  PartnerSponsoredContent
  BroadcastPodcastAppearance
  Other
}

enum SubmissionStatus {
  Draft
  Submitted
  UnderReview
  ChangesRequested
  Accepted
  Published
  Rejected
  Withdrawn
}

model User {
  id                  String        @id @default(cuid())
  name                String?
  email               String?       @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  contentItems        ContentItem[]
  seoChecks           SeoCheck[]
  agents              Agent[]
  createdGoals        Goal[]        @relation("GoalCreator")
  acceptedWorkstreams Workstream[]  @relation("WorkstreamAcceptor")
  taskComments        TaskComment[] @relation("UserCommentAuthor")
  createdTasks        Task[]        @relation("TaskCreator")
  assignedTasks       Task[]        @relation("TaskOwner")
}

model ContentItem {
  id          String    @id @default(cuid())
  userId      String
  title       String?
  url         String?
  type        String?
  platform    String?
  topics      String[]  @default([])
  status      String
  createdDate DateTime  @db.Date
  publishDate DateTime? @db.Date
  updatedDate DateTime? @db.Date
  views       Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdDate])
  @@index([userId, status])
}

model PressCoverage {
  id                  String            @id @default(cuid())
  title               String
  outlet              String
  articleType         ArticleType?
  articleTypeOther    String?
  publishedArticleUrl String?
  publicationDate     DateTime?
  summary             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  submissions         PressSubmission[]
  outletId            String?
  pressOutlet         PressOutlet?      @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([outletId])
}

model PressSubmission {
  id                  String           @id @default(cuid())
  title               String
  outlet              String
  articleType         ArticleType?
  articleTypeOther    String?
  status              SubmissionStatus @default(Draft)
  dateSubmitted       DateTime?
  responsiblePerson   String?
  followUpDate        DateTime?
  draftUrl            String?
  publishedArticleUrl String?
  notes               String?
  coverageId          String?
  coverage            PressCoverage?   @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  outletId            String?
  pressOutlet         PressOutlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeoCheck {
  id             String   @id @default(cuid())
  url            String
  normalizedUrl  String
  score          Int
  categoryScores Json
  snapshot       Json
  results        Json
  errorCount     Int
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([normalizedUrl, createdAt])
}

model SeoSettings {
  id        String   @id @default("workspace")
  pageUrl   String
  updatedAt DateTime @updatedAt
}

enum DirectoryStatus {
  NotSubmitted
  PendingReview
  NeedsChanges
  Live
  Rejected
}

enum DirectoryPriority {
  High
  Medium
  Low
}

model Directory {
  id             String                   @id @default(cuid())
  name           String
  website        String
  status         DirectoryStatus          @default(NotSubmitted)
  priority       DirectoryPriority        @default(Medium)
  dateSubmitted  DateTime?                @db.Date
  listingUrl     String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  activities     DirectoryActivity[]
  checklistItems DirectoryChecklistItem[]

  @@index([status])
}

/// A team-wide log of directory changes. Stores the directory's name so entries survive its deletion.
model DirectoryActivity {
  id            String           @id @default(cuid())
  directoryId   String?
  directory     Directory?       @relation(fields: [directoryId], references: [id], onDelete: SetNull)
  directoryName String
  message       String
  status        DirectoryStatus?
  createdAt     DateTime         @default(now())

  @@index([createdAt])
}

model DirectoryChecklistItem {
  id          String    @id @default(cuid())
  directoryId String
  directory   Directory @relation(fields: [directoryId], references: [id], onDelete: Cascade)
  label       String
  done        Boolean   @default(false)
  isDefault   Boolean   @default(false)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([directoryId, position])
}

/// Team-wide reusable text for directory submissions (taglines, descriptions).
model SavedCopy {
  id        String   @id @default(cuid())
  label     String
  text      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

enum OutletTier {
  Tier1
  Tier2
  Tier3
}

/// One media outlet, shared by every piece of coverage and pitch for it. `key` is the name with case,
/// spaces and punctuation removed, so "TechCabal" and "Tech Cabal" are one outlet.
model PressOutlet {
  id           String            @id @default(cuid())
  name         String
  key          String            @unique
  website      String?
  contactName  String?
  contactEmail String?
  tier         OutletTier?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  coverage     PressCoverage[]
  submissions  PressSubmission[]
}

// An AI agent a user connects to the platform. The plain key is shown once at creation; only its hash is stored.
model Agent {
  id                  String        @id @default(cuid())
  name                String
  speciality          String        // e.g. "seo", "content", "research"
  description         String?
  avatarStyle         String        @default("bottts")
  avatarSeed          String        @default("default")
  keyHash             String        @unique
  keyHint             String
  ownerId             String
  owner               User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connectedAt         DateTime?
  lastActiveAt        DateTime?
  proposedWorkstreams Workstream[]  @relation("WorkstreamProposer")
  assignedTasks       Task[]        @relation("AssignedAgent")
  offeredTasks        Task[]        @relation("OfferedAgent")
  comments            TaskComment[] @relation("AgentCommentAuthor")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([ownerId])
  @@index([keyHash])
}

enum GoalType {
  seo
  content
  marketing
  research
  outreach
}

enum GoalStatus {
  active
  completed
  archived
}

model Goal {
  id          String        @id @default(cuid())
  title       String
  description String?
  type        GoalType      @default(marketing)
  status      GoalStatus    @default(active)
  createdById String
  createdBy   User          @relation("GoalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  workstreams Workstream[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdById])
}

enum WorkstreamStatus {
  proposed
  accepted
  rejected
}

model Workstream {
  id                String           @id @default(cuid())
  goalId            String
  goal              Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  status            WorkstreamStatus @default(proposed)
  autoAcceptTasks   Boolean          @default(false)
  proposedByAgentId String?
  proposedByAgent   Agent?           @relation("WorkstreamProposer", fields: [proposedByAgentId], references: [id], onDelete: SetNull)
  acceptedById      String?
  acceptedBy        User?            @relation("WorkstreamAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  tasks             Task[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([goalId, title])
  @@index([goalId, status])
  @@index([proposedByAgentId])
}

enum TaskType {
  Call
  Email
  FollowUp
  Meeting
  Other
}

enum TaskStatus {
  proposed
  open
  bidding
  in_progress
  submitted
  in_review
  changes_requested
  approved
  reopened
}

model Task {
  id               String        @id @default(cuid())
  workstreamId     String?
  workstream       Workstream?   @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  taskType         String?       // "research", "lead_hunting", "content", "seo", "press"
  type             TaskType      @default(Other)
  title            String
  description      String?
  status           TaskStatus    @default(proposed)
  assignedAgentId  String?
  assignedAgent    Agent?        @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  offeredToAgentId String?
  offeredToAgent   Agent?        @relation("OfferedAgent", fields: [offeredToAgentId], references: [id], onDelete: SetNull)
  offeredAt        DateTime?
  offerExpiresAt   DateTime?
  revisionCount    Int           @default(0)
  maxRevisions     Int           @default(2)
  comments         TaskComment[]

  // Legacy Task fields retained as optional for backwards compatibility
  dueAt            DateTime?
  done             Boolean       @default(false)
  completedAt      DateTime?
  ownerId          String?
  owner            User?         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?         @relation("TaskCreator", fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([workstreamId, status])
  @@index([assignedAgentId])
  @@index([offeredToAgentId])
  @@index([userId, done])
   @@index([ownerId])
}

enum CommentType {
  idea
  bid
  review
  delivery
  revision_request
  approval
  escalation
  note
}

model TaskComment {
  id            String      @id @default(cuid())
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type          CommentType @default(note)
  tag           String?     // e.g. "blog", "leads", "contact_list", "press", "seo"
  title         String?
  body          String
  attachment    String?     // Deliverable text, URL, or link
  score         Int?        // Peer review score (e.g. 1-10)
  authorAgentId String?
  authorAgent   Agent?      @relation("AgentCommentAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  authorUserId  String?
  authorUser    User?       @relation("UserCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([taskId, type])
  @@index([authorAgentId])
  @@index([authorUserId])
}


